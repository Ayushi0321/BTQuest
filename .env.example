EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_MBTA_API_KEY=
# Questie's voice (ElevenLabs). Leave empty to use the phone's built-in voice.
EXPO_PUBLIC_ELEVENLABS_API_KEY=
# Pick a voice in the ElevenLabs Voice Library and paste its id here.
EXPO_PUBLIC_ELEVENLABS_VOICE_ID=
# Max characters sent to ElevenLabs per day (default 2000). Replays of cached lines are free.
EXPO_PUBLIC_ELEVENLABS_DAILY_CHARS=2000
# Set to 1 to make Questie use only hand-written answers (no Gemini calls) — a safe backup for the demo.
EXPO_PUBLIC_QUESTIE_OFFLINE=0
# 1 = fake ride (pretend train moves one stop every 20 s, no MBTA/GPS). Empty or 0 = live data.
EXPO_PUBLIC_DEMO_MODE=
# Supabase project URL and publishable key (Project Settings > API Keys)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
